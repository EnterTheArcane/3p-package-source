# Built natively on GitHub's Ubuntu ARM64 runner.

include(_common)

[settings]
os=Linux
arch=armv8
compiler=clang
compiler.version=18
compiler.cppstd=20
compiler.libcxx=libstdc++11

[options]
*:fPIC=True

[conf]
user.o3de:platform=linux-arm
tools.build:compiler_executables={"c": "clang-18", "cpp": "clang++-18"}
