# Cross-compiled from an x64 Linux host.
# Requires the aarch64 sysroot (crossbuild-essential-arm64) on the build machine.

include(_common)

[settings]
os=Linux
arch=armv8
compiler=clang
compiler.version=18
compiler.cppstd=20
compiler.libcxx=libstdc++11

[options]
*:fPIC=True

[conf]
tools.build:cflags=["--target=aarch64-linux-gnu"]
tools.build:cxxflags=["--target=aarch64-linux-gnu"]
tools.build:exelinkflags=["--target=aarch64-linux-gnu"]
tools.build:sharedlinkflags=["--target=aarch64-linux-gnu"]
