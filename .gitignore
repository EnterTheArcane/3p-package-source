.idea/
.vscode/
__pycache__
.DS_Store
TestResults/**
.pytest_cache
packages/
**/temp/**
qt_compile_log.txt
.remote_cache.json
.venv/
build.log
build/

# Running `conan source` or `conan build` against a recipe folder materialises the
# downloaded source and build tree next to the recipe. Recipes hold instructions, never
# upstream sources. Narrow patterns on purpose: a recipe may legitimately export a file
# from a src/ directory, and a blanket rule would drop it from the repository silently.
recipes/*/all/src/*/
recipes/*/all/src/*.c
recipes/*/all/src/*.h
recipes/*/all/build/

# Conan writes environment scripts into the working directory when a hand-run
# `conan install` or `conan create` does not pass --envs-generation=false.
conanbuild*
conanrun*
deactivate_conan*
